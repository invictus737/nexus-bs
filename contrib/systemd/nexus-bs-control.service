[Unit]
Description=Nexus-BS v0.1.72 local control service
Documentation=man:systemd.service(5)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/nexus-bs
RuntimeDirectory=nexus-bs
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/rm -f /run/nexus-bs/control.commands
ExecStartPre=/usr/bin/mkfifo -m 0600 /run/nexus-bs/control.commands
ExecStart=/bin/sh -c 'while true; do /bin/cat /run/nexus-bs/control.commands; done | exec /opt/nexus-bs/bin/nexus-bs-control-service --listen 127.0.0.1:9002 --command-listen 127.0.0.1:9003'

KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
CPUAffinity=3
CPUWeight=50
Nice=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-bs-control

[Install]
WantedBy=multi-user.target
