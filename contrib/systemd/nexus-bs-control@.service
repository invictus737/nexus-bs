# Nexus-BS local control service template.
#
# The service exposes the local WebSocket command endpoint used by nexus-bs.
# Operator commands can be written to /run/nexus-bs-USER/control.commands, or
# sent by the flat-folder /home/USER/nexus-bs/nexus-bs-control wrapper.

[Unit]
Description=Nexus-BS v0.1.57 local control service for %i
Documentation=man:systemd.service(5)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/nexus-bs
RuntimeDirectory=nexus-bs-%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/rm -f /run/nexus-bs-%i/control.commands
ExecStartPre=/usr/bin/mkfifo -m 0600 /run/nexus-bs-%i/control.commands
ExecStart=/bin/sh -c 'while true; do /bin/cat /run/nexus-bs-%i/control.commands; done | exec /home/%i/nexus-bs/nexus-bs-control-service --listen 127.0.0.1:9002'

KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-bs-control

[Install]
WantedBy=multi-user.target
