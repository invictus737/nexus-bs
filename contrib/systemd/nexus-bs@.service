# Nexus-BS system service template.
#
# Install for a user with:
#   sudo install -m 0644 contrib/systemd/nexus-bs@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nexus-bs@USER.service
#
# Layout expected:
#   /home/%i/nexus-bs/nexus-bs
#   /home/%i/nexus-bs/config.toml
#
# Runtime state is copied to /run/nexus-bs-USER so subscriber recovery cache and
# logs stay volatile on read-only/appliance installs.

[Unit]
Description=Nexus-BS v0.1.64 TETRA base station service for %i
Documentation=man:systemd.service(5)
After=network-online.target nexus-bs-control@%i.service
Wants=network-online.target nexus-bs-control@%i.service
StartLimitIntervalSec=0

[Service]
Type=notify
User=%i
WorkingDirectory=/home/%i/nexus-bs
RuntimeDirectory=nexus-bs-%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=NEXUS_BS_SERVICE_UNIT=nexus-bs@%i.service
Environment=NEXUS_BS_PERSISTENT_CONFIG=/home/%i/nexus-bs/config.toml
Environment=NEXUS_BS_DASHBOARD_STATIC_DIR=/home/%i/nexus-bs/dashboard
Environment=NEXUS_BS_CORE_DASHBOARD_BIND=127.0.0.1
Environment=NEXUS_BS_CORE_DASHBOARD_PORT=18080
Environment=RUST_LOG=info,tetra_entities::messagerouter=warn,tetra_entities::phy::phy_bs=warn,tetra_entities::mm::components::client_state=warn

# Copy config into tmpfs before start. nexus-bs derives the subscriber recovery
# path from the config path, so /run/nexus-bs-%i/config.toml keeps the
# .subscribers cache volatile while the editable config stays beside the binary.
ExecStartPre=/usr/bin/install -m 0600 /home/%i/nexus-bs/config.toml /run/nexus-bs-%i/config.toml
ExecStartPre=/bin/sh -c 'if [ -f "$1" ]; then /usr/bin/install -m 0600 "$1" "$2"; fi' nexus-bs-copy-fallback /home/%i/nexus-bs/config.toml.fallback /run/nexus-bs-%i/config.toml.fallback
ExecStart=/home/%i/nexus-bs/nexus-bs /run/nexus-bs-%i/config.toml

KillSignal=SIGINT
TimeoutStopSec=20
NotifyAccess=main
WatchdogSec=30s
Restart=on-failure
RestartSec=5
RestartForceExitStatus=75
OOMPolicy=stop
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=yes
CPUAffinity=0 1 2
CPUWeight=900

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-bs

[Install]
WantedBy=multi-user.target
