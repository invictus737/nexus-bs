[Unit]
Description=Nexus-BS v0.1.74 TETRA base station service
Documentation=man:systemd.service(5)
After=network-online.target nexus-bs-control.service
Wants=network-online.target nexus-bs-control.service
StartLimitIntervalSec=0

[Service]
Type=notify
WorkingDirectory=/opt/nexus-bs
RuntimeDirectory=nexus-bs
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=NEXUS_BS_SERVICE_UNIT=nexus-bs.service
Environment=NEXUS_BS_PERSISTENT_CONFIG=/etc/nexus-bs/config.toml
Environment=RUST_LOG=info,tetra_entities::umac=warn,tetra_entities::llc=warn,tetra_entities::mle=warn,tetra_entities::mm=warn,tetra_entities::cmce=warn,tetra_entities::sndcp=warn,tetra_entities::lmac=warn,tetra_entities::phy=warn,tetra_entities::network=warn,tetra_entities::net_telemetry=warn,tetra_entities::messagerouter=warn

ExecStartPre=/usr/bin/install -m 0600 /etc/nexus-bs/config.toml /run/nexus-bs/config.toml
ExecStartPre=/bin/sh -c 'if [ -f "$1" ]; then /usr/bin/install -m 0600 "$1" "$2"; fi' nexus-bs-copy-fallback /etc/nexus-bs/config.toml.fallback /run/nexus-bs/config.toml.fallback
ExecStart=/opt/nexus-bs/bin/nexus-bs /run/nexus-bs/config.toml

KillSignal=SIGINT
TimeoutStopSec=20
NotifyAccess=main
WatchdogSec=30s
Restart=on-failure
RestartSec=5
RestartForceExitStatus=75
OOMPolicy=stop
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=yes
CPUAffinity=1 2
CPUWeight=900
CPUSchedulingPolicy=rr
CPUSchedulingPriority=80
LimitRTPRIO=80

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-bs

[Install]
WantedBy=multi-user.target
