[Unit]
Description=Nexus-BS v0.1.71_dev external dashboard front-end
Documentation=man:systemd.service(5)
After=network-online.target nexus-bs.service
Wants=network-online.target nexus-bs.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=chris
WorkingDirectory=/home/chris/nexus-bs
Environment=NEXUS_BS_DASHBOARD_BIND=0.0.0.0
Environment=NEXUS_BS_DASHBOARD_PORT=8080
Environment=NEXUS_BS_DASHBOARD_CORE=127.0.0.1:18080
Environment=NEXUS_BS_DASHBOARD_STATIC_DIR=/home/chris/nexus-bs/dashboard
Environment=RUST_LOG=info
ExecStart=/home/chris/nexus-bs/nexus-bs-dashboard

KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
MemoryMax=192M
TasksMax=64
LimitNOFILE=2048
NoNewPrivileges=yes
CPUAffinity=3
CPUWeight=20
Nice=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-bs-dashboard

[Install]
WantedBy=multi-user.target
