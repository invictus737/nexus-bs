#!/bin/sh
set -e

service_units="nexus-bs.service nexus-bs-control.service nexus-bs-dashboard.service"
legacy_unit_patterns="nexus-bs@*.service nexus-bs-control@*.service nexus-bs-dashboard@*.service"

user_exists() {
    [ -n "$1" ] && getent passwd "$1" >/dev/null 2>&1
}

detect_run_user() {
    if user_exists "${NEXUS_BS_RUN_USER:-}"; then
        printf '%s\n' "$NEXUS_BS_RUN_USER"
        return 0
    fi
    if [ -e /etc/nexus-bs/config.toml ]; then
        owner="$(stat -c '%U' /etc/nexus-bs/config.toml 2>/dev/null || true)"
        if user_exists "$owner" && [ "$owner" != "root" ]; then
            printf '%s\n' "$owner"
            return 0
        fi
    fi
    if user_exists "${SUDO_USER:-}" && [ "$SUDO_USER" != "root" ]; then
        printf '%s\n' "$SUDO_USER"
        return 0
    fi
    awk -F: '($3 >= 1000 && $3 < 60000 && $1 != "nobody") { print $1; exit }' /etc/passwd
}

install_service_user_dropins() {
    run_user="$1"
    run_group="$2"
    [ -n "$run_user" ] || return 0
    user_exists "$run_user" || return 0

    for unit in $service_units; do
        dropin_dir="/etc/systemd/system/$unit.d"
        install -d -o root -g root -m 0755 "$dropin_dir"
        {
            printf '[Service]\n'
            printf 'User=%s\n' "$run_user"
            printf 'Group=%s\n' "$run_group"
        } > "$dropin_dir/10-nexus-bs-user.conf"
        chmod 0644 "$dropin_dir/10-nexus-bs-user.conf"
    done
}

legacy_unit_needs_replacement() {
    unit_path="$1"
    [ -e "$unit_path" ] || return 1
    if [ -L "$unit_path" ]; then
        return 0
    fi
    grep -Eq 'Nexus-BS|/opt/nexus-bs|/home/[^/]+/nexus-bs|/home/%i/nexus-bs|nexus-bs-control-service|nexus-bs-dashboard|^User=chris$' "$unit_path"
}

systemd_available() {
    [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1
}

stop_disable_unit() {
    unit="$1"
    [ -n "$unit" ] || return 0
    systemd_available || return 0
    systemctl stop "$unit" >/dev/null 2>&1 || true
    systemctl disable "$unit" >/dev/null 2>&1 || true
}

retire_legacy_unit_file() {
    unit_path="$1"
    [ -e "$unit_path" ] || [ -L "$unit_path" ] || return 0
    stop_disable_unit "$(basename "$unit_path")"
    if [ -L "$unit_path" ]; then
        rm -f "$unit_path"
        return 0
    fi
    legacy_unit_needs_replacement "$unit_path" || return 0
    mv -f "$unit_path" "$unit_path.legacy-nexus-bs"
}

retire_legacy_template_units() {
    for dir in \
        /etc/systemd/system \
        /etc/systemd/system/multi-user.target.wants \
        /lib/systemd/system \
        /usr/lib/systemd/system; do
        [ -d "$dir" ] || continue
        for pattern in $legacy_unit_patterns; do
            for path in "$dir"/$pattern; do
                [ -e "$path" ] || [ -L "$path" ] || continue
                retire_legacy_unit_file "$path"
            done
        done
    done
}

repair_usr_local_helper() {
    helper="/usr/local/bin/nexus-bs-service"
    [ -e "$helper" ] || [ -L "$helper" ] || return 0
    if [ -L "$helper" ]; then
        rm -f "$helper"
        ln -s /usr/bin/nexus-bs-service "$helper"
    else
        printf 'nexus-bs: leaving non-symlink %s in place; /usr/bin/nexus-bs-service is the packaged helper\n' "$helper" >&2
    fi
}

fix_config_permissions() {
    run_user="$1"
    run_group="$2"
    [ -n "$run_user" ] || return 0
    user_exists "$run_user" || return 0

    chown -R "$run_user:$run_group" /etc/nexus-bs 2>/dev/null || true
    find /etc/nexus-bs -type d -exec chmod 0750 {} + 2>/dev/null || true
    find /etc/nexus-bs -type f -name '*.toml' -exec chmod 0600 {} + 2>/dev/null || true
    find /etc/nexus-bs -type f -name '*.toml.active' -exec chmod 0600 {} + 2>/dev/null || true
}

install_dashboard_sudoers() {
    run_user="$1"
    [ -n "$run_user" ] || return 0
    user_exists "$run_user" || return 0
    [ "$run_user" != "root" ] || return 0
    command -v visudo >/dev/null 2>&1 || return 0

    sudoers="/etc/sudoers.d/nexus-bs-dashboard"
    {
        printf '# Installed by nexus-bs. Allows the dashboard to apply Nexus-BS updates and host service actions.\n'
        printf '%s ALL=(root) NOPASSWD: /usr/bin/apt-get install -y /tmp/nexus-bs-update/nexus-bs_*.deb\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl daemon-reload, /bin/systemctl daemon-reload\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl stop nexus-bs.service nexus-bs-control.service, /bin/systemctl stop nexus-bs.service nexus-bs-control.service\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl reset-failed nexus-bs.service nexus-bs-control.service nexus-bs-dashboard.service, /bin/systemctl reset-failed nexus-bs.service nexus-bs-control.service nexus-bs-dashboard.service\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl start nexus-bs-control.service, /bin/systemctl start nexus-bs-control.service\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl start nexus-bs.service, /bin/systemctl start nexus-bs.service\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl restart nexus-bs-control.service, /bin/systemctl restart nexus-bs-control.service\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl restart nexus-bs.service, /bin/systemctl restart nexus-bs.service\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl restart nexus-bs-dashboard.service, /bin/systemctl restart nexus-bs-dashboard.service\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl --no-block restart nexus-bs-dashboard.service, /bin/systemctl --no-block restart nexus-bs-dashboard.service\n' "$run_user"
        printf '%s ALL=(root) NOPASSWD: /usr/bin/systemctl --no-block poweroff, /bin/systemctl --no-block poweroff\n' "$run_user"
    } > "$sudoers.tmp"
    chmod 0440 "$sudoers.tmp"
    if visudo -cf "$sudoers.tmp" >/dev/null 2>&1; then
        mv -f "$sudoers.tmp" "$sudoers"
    else
        rm -f "$sudoers.tmp"
    fi
}

if [ "$1" = "configure" ]; then
    run_user="$(detect_run_user)"
    run_group="$(id -gn "$run_user" 2>/dev/null || printf '%s' "$run_user")"
    enable_after_legacy_replace=""
    if ! user_exists "$run_user"; then
        run_user="root"
        run_group="root"
    fi

    install -d -o "$run_user" -g "$run_group" -m 0750 /etc/nexus-bs
    retire_legacy_template_units

    for unit in $service_units; do
        legacy="/etc/systemd/system/$unit"
        want_link="/etc/systemd/system/multi-user.target.wants/$unit"
        if legacy_unit_needs_replacement "$legacy"; then
            if [ -e "$want_link" ]; then
                enable_after_legacy_replace="$enable_after_legacy_replace $unit"
            fi
            mv -f "$legacy" "$legacy.legacy-nexus-bs"
            rm -f "$want_link"
        fi
    done

    if [ ! -e /etc/nexus-bs/config.toml ]; then
        install -o "$run_user" -g "$run_group" -m 0600 /etc/nexus-bs/examples/config.toml /etc/nexus-bs/config.toml
    fi

    fix_config_permissions "$run_user" "$run_group"
    install_service_user_dropins "$run_user" "$run_group"
    install_dashboard_sudoers "$run_user"
    repair_usr_local_helper

    if systemd_available; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        if [ -n "$enable_after_legacy_replace" ]; then
            systemctl enable $enable_after_legacy_replace >/dev/null 2>&1 || true
        fi
    fi
fi

exit 0
